@model IEnumerable<WeddingPortal.Models.Event>

<h2>Events</h2>

<p>
    <a asp-action="Create"
       class="btn btn-primary">
        Create Event
    </a>
</p>

<table class="table table-striped">

    <thead>
        <tr>
            <th>Title</th>
            <th>Location</th>
            <th>Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Title</td>

                <td>@item.Location</td>

                <td>@item.EventDate</td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.Id">
                        Details
                    </a>

                    |

                    <a asp-action="Edit"
                       asp-route-id="@item.Id">
                        Edit
                    </a>

                    |

                    <a asp-action="Delete"
                       asp-route-id="@item.Id">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>