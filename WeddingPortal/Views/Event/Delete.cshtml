@model WeddingPortal.Models.Event

<h2>Delete Event</h2>

<p>
    Are you sure you want to delete
    @Model.Title ?
</p>

<form asp-action="Delete">

    <input type="hidden"
           asp-for="Id" />

    <button class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>