@model WeddingPortal.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Hem";
}

<section class="hero-section">

    <div class="hero-content">

        <span class="hero-small-title">
            @(Model.FeaturedWeddingInfo?.HeroSubtitle
                        ?? "Vår stora dag")
        </span>

        <h1>
            @(Model.FeaturedWeddingInfo?.HeroTitle
                        ?? Model.FeaturedWeddingInfo?.WelcomeMessage
                        ?? "Välkommen")
        </h1>

        <p class="hero-description">
            @(Model.FeaturedWeddingInfo?.HeroDescription
                        ?? Model.FeaturedWeddingInfo?.VenueInformation)
        </p>

        @if (Model.FeaturedWeddingInfo?.Event != null)
        {
            <div class="hero-description">

                <strong>📍</strong>
                @Model.FeaturedWeddingInfo.Event.Location

                <br />

                <strong>📅</strong>
                @Model.FeaturedWeddingInfo.Event.EventDate

            </div>
        }

        <div class="hero-divider">
            <span>♡</span>
        </div>

        <div class="hero-actions">

            <a asp-controller="Guest"
               asp-action="Create"
               class="wedding-button">
                OSA
            </a>

            <a asp-controller="Event"
               asp-action="Index"
               class="wedding-button wedding-button-outline">
                Se evenemang
            </a>

        </div>

    </div>

</section>

@if (Model.FeaturedWeddingInfo != null)
{
    <section class="welcome-section">

        <div class="welcome-card">

            @if (Model.FeaturedWeddingInfo.Event != null)
            {
                <h2>
                    @Model.FeaturedWeddingInfo.Event.Title
                </h2>

                <p>
                    📍 @Model.FeaturedWeddingInfo.Event.Location
                </p>

                <p>
                    📅 @Model.FeaturedWeddingInfo.Event.EventDate
                </p>

                <hr />
            }

            <h3>Välkommen</h3>

            <p>
                @Model.FeaturedWeddingInfo.WelcomeMessage
            </p>

            <h3>Platsinformation</h3>

            <p>
                @Model.FeaturedWeddingInfo.VenueInformation
            </p>

            <h3>Kontakt</h3>

            <p>
                @Model.FeaturedWeddingInfo.ContactInformation
            </p>

        </div>

    </section>
}