@model WeddingPortal.Models.Guest

<h2>Delete Guest</h2>

<p>
    Are you sure you want to delete:
</p>

<h4>@Model.Name</h4>

<form asp-action="DeleteConfirmed">

    <input asp-for="Id"
           type="hidden" />

    <button class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>