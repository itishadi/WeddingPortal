@model GuestEditViewModel

@{
    ViewData["Title"] = "Ändra gäst";
}

<section class="form-page">

    <div class="form-card">

        <div class="form-header">
            <span class="section-label">Gästhantering</span>

            <h1>Ändra gäst</h1>

            <p>
                Uppdatera gästens information och OSA-svar.
            </p>
        </div>

        <form asp-action="Edit"
              method="post">

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <div class="form-group">

                <label asp-for="Name">
                    Namn
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Email">
                    E-post
                </label>

                <input asp-for="Email"
                       class="form-control" />

                <span asp-validation-for="Email"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="PhoneNumber">
                    Telefonnummer
                </label>

                <input asp-for="PhoneNumber"
                       class="form-control" />

                <span asp-validation-for="PhoneNumber"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="NumberOfAttendants">
                    Antal personer
                </label>

                <input asp-for="NumberOfAttendants"
                       class="form-control"
                       type="number"
                       min="0"
                       max="10" />

                <span asp-validation-for="NumberOfAttendants"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="WillAttend">
                    OSA-status
                </label>

                <select asp-for="WillAttend"
                        class="form-select">

                    <option value="">
                        Inte svarat
                    </option>

                    <option value="true">
                        Kommer
                    </option>

                    <option value="false">
                        Kommer inte
                    </option>

                </select>

                <span asp-validation-for="WillAttend"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Message">
                    Meddelande
                </label>

                <textarea asp-for="Message"
                          class="form-control"
                          rows="5"
                          placeholder="Eventuellt meddelande...">
                </textarea>

                <span asp-validation-for="Message"
                      class="field-validation">
                </span>

            </div>

            <div class="form-actions">

                <button type="submit"
                        class="wedding-button">
                    Spara ändringar
                </button>

                <a asp-action="Index"
                   class="wedding-button wedding-button-outline">
                    Avbryt
                </a>

            </div>

        </form>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}