@model WeddingPortal.Models.Guest

<h2>Edit Guest</h2>

<form asp-action="Edit" method="post">

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">

        <label asp-for="Name"></label>

        <input asp-for="Name"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label asp-for="Email"></label>

        <input asp-for="Email"
               class="form-control" />

    </div>

    <button class="btn btn-primary">
        Update
    </button>

</form>