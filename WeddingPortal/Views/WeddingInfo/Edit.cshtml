@model WeddingInfo

@{
    ViewData["Title"] = "Ändra bröllopsinformation";
}

<section class="form-page">

    <div class="form-card">

        <div class="form-header">

            <span class="section-label">
                Bröllopsinformation
            </span>

            <h1>Ändra information</h1>

            <p>
                Uppdatera informationen som visas på webbplatsen.
            </p>

        </div>

        <form asp-action="Edit"
              method="post">

            <input asp-for="Id"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <div class="form-group">

                <label asp-for="WelcomeMessage">
                    Välkomstmeddelande
                </label>

                <textarea asp-for="WelcomeMessage"
                          class="form-control"
                          rows="6">
                </textarea>

                <span asp-validation-for="WelcomeMessage"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="VenueInformation">
                    Platsinformation
                </label>

                <textarea asp-for="VenueInformation"
                          class="form-control"
                          rows="6">
                </textarea>

                <span asp-validation-for="VenueInformation"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="ContactInformation">
                    Kontaktinformation
                </label>

                <textarea asp-for="ContactInformation"
                          class="form-control"
                          rows="5">
                </textarea>

                <span asp-validation-for="ContactInformation"
                      class="field-validation">
                </span>

            </div>

            <div class="form-actions">

                <button type="submit"
                        class="wedding-button">
                    Spara ändringar
                </button>

                <a asp-action="Index"
                   class="wedding-button wedding-button-outline">
                    Avbryt
                </a>

            </div>

        </form>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}